{
"manifest_version": 3,
"name": "Multi-Platform Profile Scraper",
"version": "1.0.0",
"description": "Sends HTML to backend for LinkedIn and Instagram profile scraping",
"permissions": [
"activeTab",
"scripting"
],
"host_permissions": [
"https://www.linkedin.com/",
"https://www.instagram.com/"
],
"action": {
"default_popup": "popup/popup.html",
"default_icon": {
"16": "icons/icon16.png",
"48": "icons/icon48.png",
"128": "icons/icon128.png"
}
}
}